<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zonas PEC — Salud Mental y Adicciones · Municipalidad de Córdoba</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
:root{
  --bg:#0f1117; --panel:#1a1d27; --panel2:#22263a; --border:#2e3352;
  --text:#e8eaf6; --text2:#9ba3c7; --accent:#4fc3f7;
  --mono:'IBM Plex Mono',monospace; --sans:'IBM Plex Sans',sans-serif;
  --c-yap:#9b59b6; --c-rob:#27ae60; --c-mal:#16a085; --c-com:#e74c3c;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:var(--sans);height:100dvh;display:flex;flex-direction:column;overflow:hidden;}
header{background:var(--panel);border-bottom:2px solid var(--border);padding:10px 16px;display:flex;align-items:center;gap:14px;flex-shrink:0;}
header h1{font-family:var(--mono);font-size:13px;font-weight:700;color:var(--accent);letter-spacing:.06em;}
header .sub{font-size:11px;color:var(--text2);}
header .meta{margin-left:auto;font-family:var(--mono);font-size:11px;color:var(--text2);}
.bar{background:var(--panel2);border-bottom:1px solid var(--border);padding:8px 12px;display:flex;gap:8px;align-items:center;flex-shrink:0;flex-wrap:wrap;}
.bar label{font-family:var(--mono);font-size:11px;color:var(--text2);white-space:nowrap;text-transform:uppercase;letter-spacing:.05em;}
.chip{background:var(--panel);border:1px solid var(--border);font-family:var(--mono);font-size:11px;font-weight:600;padding:6px 12px;border-radius:5px;cursor:pointer;color:var(--text2);transition:all .15s;}
.chip:hover{background:var(--panel2);color:var(--text);}
.chip.active{color:#000;border-color:transparent;}
.chip.active[data-zona="yapeyu"]{background:var(--c-yap);}
.chip.active[data-zona="los_robles"]{background:var(--c-rob);}
.chip.active[data-zona="maldonado"]{background:var(--c-mal);}
.chip.active[data-zona="comercial"]{background:var(--c-com);}
.chip.active[data-zona="todas"]{background:var(--accent);}
.chip .dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:middle;}
.bar-sep{width:1px;height:22px;background:var(--border);margin:0 6px;}
.btn-lay{background:transparent;border:1px solid var(--border);color:var(--text2);font-family:var(--mono);font-size:10px;padding:5px 10px;border-radius:4px;cursor:pointer;transition:all .15s;}
.btn-lay:hover,.btn-lay.active{background:var(--accent);color:#000;border-color:var(--accent);}
main{flex:1;display:flex;overflow:hidden;}
#mapa{flex:1;background:#ddd;}
.leaflet-container{background:#0f1117;}
aside{width:320px;background:var(--panel);border-left:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;}
.panel-head{padding:14px 16px 10px;border-bottom:1px solid var(--border);}
.panel-head .titulo{font-family:var(--mono);font-size:14px;font-weight:700;margin-bottom:4px;}
.panel-head .subtitulo{font-size:11px;color:var(--text2);line-height:1.4;}
.panel-head .count{margin-top:8px;font-family:var(--mono);font-size:10px;color:var(--text2);text-transform:uppercase;letter-spacing:.05em;}
.panel-head .count b{color:var(--accent);font-size:14px;}
.panel-body{flex:1;overflow-y:auto;padding:12px 16px;}
.panel-body h4{font-family:var(--mono);font-size:10px;color:var(--text2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;border-bottom:1px solid var(--border);padding-bottom:4px;}
.radio-item{display:inline-block;font-family:var(--mono);font-size:11px;background:var(--panel2);border:1px solid var(--border);padding:3px 8px;border-radius:3px;margin:2px 3px 2px 0;}
.leyenda{background:var(--panel);border-top:1px solid var(--border);padding:10px 16px;font-size:11px;}
.leyenda .li{display:flex;align-items:center;gap:8px;margin:3px 0;}
.leyenda .lb{width:16px;height:12px;border-radius:2px;border:1px solid rgba(255,255,255,.15);}
.map-legend{background:rgba(15,17,23,.92);border:1px solid var(--border);padding:8px 10px;font-family:var(--sans);font-size:11px;color:var(--text);border-radius:4px;}
.map-legend .lb{width:14px;height:10px;display:inline-block;margin-right:6px;vertical-align:middle;border-radius:2px;}
.stat-line{display:flex;justify-content:space-between;padding:4px 0;font-family:var(--mono);font-size:11px;border-bottom:1px dashed var(--border);}
.stat-line span:first-child{color:var(--text2);}
.stat-line span:last-child{color:var(--text);font-weight:600;}
@media (max-width:900px){aside{width:100%;height:280px;border-left:none;border-top:1px solid var(--border);}main{flex-direction:column;}}
</style>
</head>
<body>

<header>
  <h1>PEC / SALUD MENTAL Y ADICCIONES</h1>
  <span class="sub">Municipalidad de Córdoba — Zonas de influencia · Muestreo territorial</span>
  <span class="meta">80 radios censales · 4 zonas</span>
</header>

<div class="bar">
  <label>Zona:</label>
  <button class="chip active" data-zona="todas" onclick="verZona('todas', this)"><span class="dot" style="background:var(--accent)"></span>Todas</button>
  <button class="chip" data-zona="yapeyu" onclick="verZona('yapeyu', this)"><span class="dot" style="background:var(--c-yap)"></span>Yapeyú</button>
  <button class="chip" data-zona="los_robles" onclick="verZona('los_robles', this)"><span class="dot" style="background:var(--c-rob)"></span>Los Robles</button>
  <button class="chip" data-zona="maldonado" onclick="verZona('maldonado', this)"><span class="dot" style="background:var(--c-mal)"></span>Maldonado</button>
  <button class="chip" data-zona="comercial" onclick="verZona('comercial', this)"><span class="dot" style="background:var(--c-com)"></span>Comercial</button>

  <div class="bar-sep"></div>
  <label>Mapa base:</label>
  <button class="btn-lay active" onclick="setLayer('osm', this)">OSM</button>
  <button class="btn-lay" onclick="setLayer('sat', this)">Satélite</button>
  <button class="btn-lay" onclick="setLayer('goog', this)">Google</button>
</div>

<main>
  <div id="mapa"></div>
  <aside>
    <div class="panel-head">
      <div class="titulo" id="p-titulo">Vista general</div>
      <div class="subtitulo" id="p-sub">Las 4 zonas PEC de la Municipalidad de Córdoba sobre el mapa de la ciudad.</div>
      <div class="count" id="p-count"><b>80</b> radios censales seleccionados</div>
    </div>
    <div class="panel-body" id="p-body">
      <h4>Resumen por zona</h4>
      <div class="stat-line"><span>● Yapeyú</span><span id="stat-yap">–</span></div>
      <div class="stat-line"><span>● Los Robles</span><span id="stat-rob">–</span></div>
      <div class="stat-line"><span>● Maldonado</span><span id="stat-mal">–</span></div>
      <div class="stat-line"><span>● Comercial</span><span id="stat-com">–</span></div>
    </div>
    <div class="leyenda">
      <div style="font-family:var(--mono);font-weight:700;font-size:10px;color:var(--accent);margin-bottom:6px;letter-spacing:.05em;">REFERENCIAS</div>
      <div class="li"><div class="lb" style="background:var(--c-yap)"></div>Yapeyú</div>
      <div class="li"><div class="lb" style="background:var(--c-rob)"></div>Los Robles</div>
      <div class="li"><div class="lb" style="background:var(--c-mal)"></div>Maldonado</div>
      <div class="li"><div class="lb" style="background:var(--c-com)"></div>Comercial</div>
    </div>
  </aside>
</main>


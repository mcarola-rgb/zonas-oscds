const ZONAS = {"yapeyu": {"nombre": "Yapey\u00fa", "color": "#9b59b6", "barrios": "Bajo Pueyrred\u00f3n \u00b7 Bajada de Piedra \u00b7 Yapey\u00fa \u00b7 Bajo Yapey\u00fa", "sw": [-31.41865, -64.15714], "ne": [-31.39965, -64.12351], "count": 18}, "los_robles": {"nombre": "Los Robles", "color": "#27ae60", "barrios": "Quebrada de las Rosas \u00b7 Villa Sol \u00b7 Ampliaci\u00f3n Las Palmas \u00b7 Puente Blanco", "sw": [-31.41196, -64.27006], "ne": [-31.39543, -64.24011], "count": 32}, "maldonado": {"nombre": "Maldonado", "color": "#16a085", "barrios": "Maldonado \u00b7 La Ribera \u00b7 Bajada San Jos\u00e9 \u00b7 Los Josefinos \u00b7 Renacimiento", "sw": [-31.42188, -64.14412], "ne": [-31.40515, -64.1177], "count": 22}, "comercial": {"nombre": "Comercial", "color": "#e74c3c", "barrios": "Villa El Libertador \u00b7 Mirizzi \u00b7 Santa Rosa Residencial \u00b7 Comercial", "sw": [-31.48757, -64.21047], "ne": [-31.47407, -64.20255], "count": 8}};
const VISTA_GENERAL = { sw: [-31.48757, -64.27006], ne: [-31.39543, -64.1177] };

let mapa, layerGroup, tileOSM, tileSAT, tileGOOG;

function initMapa(){
  mapa = L.map('mapa', {zoomControl:true, preferCanvas:true});
  tileOSM  = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {attribution:'© OSM', maxZoom:19});
  tileSAT  = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {attribution:'© Esri', maxZoom:19});
  tileGOOG = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {attribution:'© Google', maxZoom:20});
  tileOSM.addTo(mapa);
  layerGroup = L.featureGroup().addTo(mapa);
  dibujarTodo();
  mapa.fitBounds([VISTA_GENERAL.sw, VISTA_GENERAL.ne], {padding:[30,30]});
}

function setLayer(name, btn){
  [tileOSM, tileSAT, tileGOOG].forEach(t => { try { mapa.removeLayer(t); } catch(e){} });
  if(name==='osm')  tileOSM.addTo(mapa);
  if(name==='sat')  tileSAT.addTo(mapa);
  if(name==='goog') tileGOOG.addTo(mapa);
  document.querySelectorAll('.btn-lay').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

function colorSector(s){
  return ZONAS[s] ? ZONAS[s].color : '#888';
}

function dibujarTodo(){
  layerGroup.clearLayers();
  L.geoJSON(GEOJSON, {
    style: f => ({
      color: colorSector(f.properties.sector),
      weight: 1.4,
      fillColor: colorSector(f.properties.sector),
      fillOpacity: 0.45
    }),
    onEachFeature: (f, layer) => {
      const p = f.properties;
      const nombre = ZONAS[p.sector] ? ZONAS[p.sector].nombre : p.sector;
      layer.bindTooltip(`<b>${nombre}</b><br>Radio ${p.etiqueta}`, {sticky:true, direction:'top'});
      layer.bindPopup(
        `<div style="font-family:'IBM Plex Sans',sans-serif;font-size:12px;">
          <div style="font-weight:700;color:${colorSector(p.sector)};font-size:13px;margin-bottom:4px;">
            Zona ${nombre}
          </div>
          <div><b>Radio:</b> ${p.etiqueta}</div>
          <div><b>LINK:</b> ${p.link}</div>
          <div><b>Fracción:</b> ${p.frac} · <b>Radio:</b> ${p.radio}</div>
         </div>`
      );
    }
  }).addTo(layerGroup);

  // Contadores
  const conteo = {yapeyu:0, los_robles:0, maldonado:0, comercial:0};
  GEOJSON.features.forEach(f => conteo[f.properties.sector]++);
  document.getElementById('stat-yap').textContent = conteo.yapeyu + ' radios';
  document.getElementById('stat-rob').textContent = conteo.los_robles + ' radios';
  document.getElementById('stat-mal').textContent = conteo.maldonado + ' radios';
  document.getElementById('stat-com').textContent = conteo.comercial + ' radios';
}

function verZona(zona, btn){
  document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');

  if(zona === 'todas'){
    document.getElementById('p-titulo').textContent = 'Vista general';
    document.getElementById('p-sub').textContent = 'Las 4 zonas PEC de la Municipalidad de Córdoba sobre el mapa de la ciudad.';
    document.getElementById('p-count').innerHTML = '<b>' + GEOJSON.features.length + '</b> radios censales seleccionados';
    document.getElementById('p-body').innerHTML = `
      <h4>Resumen por zona</h4>
      <div class="stat-line"><span>● Yapeyú</span><span>${countBy('yapeyu')} radios</span></div>
      <div class="stat-line"><span>● Los Robles</span><span>${countBy('los_robles')} radios</span></div>
      <div class="stat-line"><span>● Maldonado</span><span>${countBy('maldonado')} radios</span></div>
      <div class="stat-line"><span>● Comercial</span><span>${countBy('comercial')} radios</span></div>
      <div style="margin-top:14px;font-size:11px;color:var(--text2);line-height:1.5;">
        Usá los botones de arriba para hacer zoom a cada zona en particular.
      </div>`;
    mapa.fitBounds([VISTA_GENERAL.sw, VISTA_GENERAL.ne], {padding:[30,30]});
    return;
  }

  const z = ZONAS[zona];
  document.getElementById('p-titulo').innerHTML = '<span style="color:'+z.color+'">■</span> ' + z.nombre;
  document.getElementById('p-sub').textContent = z.barrios;
  document.getElementById('p-count').innerHTML = '<b>' + z.count + '</b> radios censales';

  // Lista de radios de esa zona
  const radios = GEOJSON.features
    .filter(f => f.properties.sector === zona)
    .map(f => f.properties.etiqueta)
    .sort();
  let html = '<h4>Radios censales (fracción-radio)</h4><div>';
  radios.forEach(r => { html += '<span class="radio-item">'+r+'</span>'; });
  html += '</div>';
  document.getElementById('p-body').innerHTML = html;

  mapa.flyToBounds([z.sw, z.ne], {padding:[60,60], duration:0.8});
}

function countBy(sector){
  return GEOJSON.features.filter(f => f.properties.sector === sector).length;
}

initMapa();
</script>
